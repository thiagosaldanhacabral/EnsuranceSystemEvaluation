{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=ProposalDb;User Id=sa;Password=YourStrong@Passw0rd;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "RabbitMQ": {
    "Host": "localhost",
